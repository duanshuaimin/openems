    {
      "id": 5,
      "title": "物理残差校验 (Residual Power)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "influxdb",
        "uid": "P0DBC1A8D6496B50C"
      },
      "targets": [
        {
          "query": "from(bucket: \"openems\")\n  |> range(start: -30m)\n  |> filter(fn: (r) => r.edge == \"${edge}\")\n  |> filter(fn: (r) => r._measurement == \"data\")\n  |> filter(fn: (r) => r._field == \"_sum/ConsumptionActivePower\" or r._field == \"_sum/ProductionActivePower\" or r._field == \"_sum/EssActivePower\" or r._field == \"_sum/GridActivePower\")\n  |> aggregateWindow(every: 1m, fn: mean, createEmpty: false)\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({\n      _time: r._time,\n      _field: \"Residual\",\n      _value: r[\"_sum/ConsumptionActivePower\"] - (r[\"_sum/ProductionActivePower\"] + r[\"_sum/EssActivePower\"] + r[\"_sum/GridActivePower\"])\n  }))\n  |> last()",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": -10
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
